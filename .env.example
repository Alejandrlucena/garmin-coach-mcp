GARMIN_EMAIL=tu@email.com
GARMIN_PASSWORD=tu_contraseña
GARMIN_TOKENS_JSON=
GARMIN_TIMEZONE=Europe/Madrid
GARMIN_LANGUAGE=es
CACHE_MINUTES=30

# Re-login web wizard (mobile-friendly /login flow)
# Genera un token aleatorio largo: openssl rand -hex 32
ADMIN_TOKEN=
# Railway API token (Account → Tokens) para que /login actualice GARMIN_TOKENS_JSON solo
RAILWAY_API_TOKEN=
# Las tres siguientes las inyecta Railway automáticamente en cada deploy:
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=
# Sincroniza el OAuth1 maestro a Railway si rota (poco frecuente). Off por defecto.
AUTO_SYNC_TOKENS=0
AUTO_SYNC_INTERVAL_SECONDS=43200
